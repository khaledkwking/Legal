          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="View_QuestionsStatisticsTableAdapter" GeneratorDataComponentClassName="View_QuestionsStatisticsTableAdapter" Name="View_QuestionsStatistics" UserDataComponentName="View_QuestionsStatisticsTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="CMGSDB_LiveConnectionString (Settings)" DbObjectName="" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT   ChapterNameAr,SessionNameAr,RequestedFromNameAr,
COUNT(code) AS Qcount,SUM(AnswerCount) AnsCount,
(SELECT COUNT(code) FROM Parliament_Questions WHERE StatusID=4 AND 
result.ChapterID=Parliament_Questions.ChapterID AND 
result.SessionID=Parliament_Questions.SessionID
AND result.Q_RequestFrom=Parliament_Questions.Q_RequestFrom)AS estifaaa
FROM (

SELECT View_QuestionsList.*,
(SELECT COUNT(Code) FROM Parliament_QuestionsAnswers 
WHERE View_QuestionsList.code=Parliament_QuestionsAnswers.QuestionID)AS AnswerCount
 FROM View_QuestionsList
 )AS result
 GROUP BY ChapterID,SessionID,Q_RequestFrom,ChapterNameAr,SessionNameAr,RequestedFromNameAr</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
