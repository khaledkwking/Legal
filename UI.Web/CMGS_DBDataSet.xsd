                         dbo.Parliament_RequestedToPerson ON dbo.Parliament_Questions.Q_RequestTo = dbo.Parliament_RequestedToPerson.Code LEFT OUTER JOIN
                         dbo.Parliament_Persons ON dbo.Parliament_Questions.Q_RequestFrom = dbo.Parliament_Persons.Code LEFT JOIN
                         dbo.Parliament_madbata ON Parliament_Questions.madbataRefId = Parliament_madbata.code</CommandText>
