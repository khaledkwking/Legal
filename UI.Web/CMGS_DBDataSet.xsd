                             (SELECT        NameAr + ' - ' AS 'data()'
                                FROM            Parliament_Requestedby INNER JOIN
                                                         Parliament_Orgs ON Parliament_Requestedby.PersonID = Parliament_Orgs.code
                                WHERE        PartyType = 2 AND QuestionID = Parliament_Questions.code FOR XML PATH('')) AS RelatedOrgs,
                             (SELECT        NameAr + ' - ' AS 'data()'
                                FROM            Parliament_Requestedby INNER JOIN
